{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-worker",
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/external-sync-worker.ts",
    "tests/**/*.ts",
    "lib/external-sync/**/*.ts",
    "lib/library.ts",
    "lib/presentation.ts",
    "lib/songTextCleanup.ts"
  ]
}
