{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-worker",
    "types": ["node"]
  },
  "include": [
    "legacy/external-sync/worker.ts",
    "tests/**/*.ts",
    "legacy/external-sync/lib/**/*.ts",
    "lib/library.ts",
    "lib/presentation.ts",
    "lib/song-pptx.ts",
    "lib/youtube-suggestions.ts",
    "lib/songTextCleanup.ts",
    "lib/section-editor.ts"
  ],
  "exclude": ["tests/e2e/**"]
}
