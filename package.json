{
  "name": "songapp-next-mvp",
  "version": "0.37.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-local.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components features lib legacy scripts tests proxy.ts next.config.ts playwright.config.ts",
    "format": "prettier --write app components features lib legacy scripts tests docs *.ts *.mjs *.md *.json",
    "format:check": "prettier --check app components features lib legacy scripts tests docs *.ts *.mjs *.md *.json",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "worker:build": "node scripts/clean-worker-build.mjs && tsc -p tsconfig.worker.json",
    "worker": "node --env-file-if-exists=.env.worker dist-worker/legacy/external-sync/worker.js",
    "test": "npm run worker:build && node --test dist-worker/tests/*.test.js dist-worker/tests/integration/*.test.js && node --test tests/red-book-import.test.mjs tests/black-ppt.test.mjs tests/local-build.test.mjs",
    "test:e2e": "playwright test",
    "sql:package": "node scripts/build-install-sql.mjs",
    "local": "node scripts/start-local.mjs",
    "freeshow:bridge": "node scripts/freeshow-bridge.mjs",
    "freeshow:installer": "node scripts/build-freeshow-installer.mjs",
    "build:netlify": "node scripts/netlify-preflight.mjs && next build",
    "import:red-book": "node --env-file=.env.local scripts/import-books.mjs --book=cr",
    "import:black-book": "node --env-file-if-exists=.env.local scripts/import-black-ppt.mjs",
    "import:books": "node --env-file=.env.local scripts/import-books.mjs",
    "import:black-ppt": "node --env-file-if-exists=.env.local scripts/import-black-ppt.mjs",
    "test:ppt-assets": "node --test tests/black-ppt-assets.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "cfb": "1.2.2",
    "cheerio": "1.2.0",
    "jszip": "3.10.1",
    "next": "16.4.6",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
